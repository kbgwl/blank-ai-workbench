# 后端（services/api）环境变量，复制为 services/api/.env
BLANK_APP_NAME=blank-ai-workbench
# 本机开发默认 SQLite；启用 Docker Postgres 时改为下面这行
# BLANK_DATABASE_URL=postgresql+asyncpg://blank:blank_dev_password@localhost:5432/blank
BLANK_DATABASE_URL=sqlite+aiosqlite:///./data/blank_dev.db
BLANK_REDIS_URL=redis://localhost:6379/0
BLANK_CORS_ORIGINS=["http://localhost:3000"]

# 前端（web）环境变量，复制为 web/.env.local
# API_PROXY_TARGET=http://localhost:8000

# 沙箱执行环境（阶段6），默认值见 docs/deployment.md
# Docker 是可选的加固档：没有可用容器后端时默认退回本机 Job 受限执行。
# 设 BLANK_SANDBOX_ALLOW_LOCAL=0 表示「只准容器」，无容器时整任务 409。
# BLANK_SANDBOX_ENABLED=true
# BLANK_SANDBOX_ALLOW_LOCAL=true
# BLANK_SANDBOX_IMAGE=blank-sandbox:dev
# BLANK_SANDBOX_CPUS=1.0
# BLANK_SANDBOX_MEMORY=512m
# BLANK_SANDBOX_PIDS=128
# BLANK_SANDBOX_NETWORK=false
# BLANK_SANDBOX_TIMEOUT=120
# BLANK_SANDBOX_ENV_ALLOWLIST=

# 密钥与访问令牌（生产必填）
# BLANK_SECRET_KEY=
# BLANK_API_TOKEN=

# 附件（用户贴的截图、文档、PDF）落盘位置。缺省是相对 cwd 的 data/uploads，
# 按项目分目录；删项目/删任务时随之清理，启动时扫"够老且无引用"的孤儿。
# BLANK_UPLOAD_ROOT=data/uploads
