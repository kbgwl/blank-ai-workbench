{
  "name": "blank-ai-workbench-desktop",
  "version": "0.11.0",
  "private": true,
  "description": "Blank AI（空白格）桌面壳",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/gpu-guard.test.cjs tests/api-base.test.cjs tests/shell-policy.test.cjs tests/update-policy.test.cjs tests/main-wiring.test.cjs tests/splash.test.cjs tests/app-identity.test.cjs",
    "install:local": "node install-local.cjs",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "verify": "node verify-package.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.blank.workbench",
    "productName": "Blank AI",
    "copyright": "Copyright © 2026 Blank AI Workbench contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "api-base.cjs",
      "gpu-guard.cjs",
      "shell-policy.cjs",
      "splash-policy.cjs",
      "splash.html",
      "splash-preload.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "shell/icon.ico"
      },
      {
        "from": "../web/out",
        "to": "web"
      },
      {
        "from": "build/runtime",
        "to": "backend/runtime"
      },
      {
        "from": "../services/api",
        "to": "backend/api",
        "filter": [
          "**/*",
          "!.venv/**",
          "!.venv",
          "!data/**",
          "!data",
          "!tests/**",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!.pytest_cache/**",
          "!*.pyc",
          "!.env",
          "!.env.*",
          "!.gitignore",
          "!_verify/**",
          "!_verify",
          "!logs/**",
          "!logs",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm",
          "!**/*.key"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Blank-AI-便携版-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Blank-AI-安装版-${version}.exe",
      "shortcutName": "Blank AI",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
