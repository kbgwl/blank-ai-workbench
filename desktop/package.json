{
  "name": "blank-ai-workbench-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "空白格 AI 操作台的桌面壳",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "verify": "node verify-package.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.blank.workbench",
    "productName": "空白格 AI 操作台",
    "copyright": "Copyright © 2026 Blank AI Workbench contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      },
      {
        "from": "build/runtime",
        "to": "backend/runtime"
      },
      {
        "from": "../services/api",
        "to": "backend/api",
        "filter": [
          "**/*",
          "!.venv/**",
          "!.venv",
          "!data/**",
          "!data",
          "!tests/**",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!.pytest_cache/**",
          "!*.pyc"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "空白格-便携版-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "空白格-安装版-${version}.exe",
      "shortcutName": "空白格 AI 操作台",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
