{
  "name": "blank-ai-workbench",
  "version": "0.8.17",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm -C web dev",
    "test": "node scripts/run_api_tests.mjs",
    "test:api": "node scripts/run_api_tests.mjs",
    "test:web": "pnpm -C web test",
    "test:desktop": "node --test desktop/tests/gpu-guard.test.cjs desktop/tests/api-base.test.cjs desktop/tests/shell-policy.test.cjs desktop/tests/update-policy.test.cjs desktop/tests/main-wiring.test.cjs",
    "test:evals": "node --test evals/tests/judgement.test.mjs",
    "check:versions": "node scripts/check_versions.mjs",
    "runtime:desktop": "node scripts/prepare_desktop_runtime.mjs",
    "verify:desktop": "node desktop/verify-package.cjs",
    "smoke:api": "uv run --project services/api python scripts/smoke_health.py",
    "build:web": "pnpm -C web build",
    "lint:web": "pnpm -C web lint",
    "typecheck:web": "pnpm -C web exec next typegen && pnpm -C web exec tsc --noEmit",
    "regression": "node scripts/regression.mjs",
    "evals": "node evals/run_evals.mjs",
    "eval:gate": "node evals/eval_gate.mjs",
    "ci:local": "node scripts/local_ci.mjs",
    "e2e:team": "node evals/team_e2e/run.mjs"
  }
}
