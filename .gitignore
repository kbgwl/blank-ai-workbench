node_modules/
.next/
.next-build/
dist/
packages/cli/dist/
build/
__pycache__/
*.py[cod]
.venv/
.env
.env.local
data/*.db
data/*.db-journal
data/*.log
data/mock-last-request.json
data/demo-ws/.blank_backups/
data/demo-ws/.pytest_cache/
data/demo-ws/__pycache__/
logs/
.pytest_cache/
.mypy_cache/
coverage/
evals/workspaces/
evals/results/
evals/regression/*.json
services/api/data/*
!services/api/data/.gitkeep

# desktop/build 是 electron-builder 的 buildResources（图标等），必须入库；
# 上面的 `build/` 规则会把它一起忽略，这里显式放行。
!desktop/build/
!desktop/build/**

# 但随包分发的 Python 运行时是构建产物（约 125MB），绝不入库。
desktop/build/runtime/

# electron-builder 产物（含改名隔离用的 dist-prev 等）
desktop/dist*/

# 构建时因 safe-delete 拦截而改名隔离的中间产物
web/.next-old*/
web/out-old*/

# 运行时写入前备份（与工作区绑定，不入库）
.blank_backups/

# 打包时从 site-packages 剔出来的空白副本（safe-delete 规避）
desktop/build/_removed/

# 运行期数据：密钥、产物、快照都会写进 data/，这些绝不入库
data/*.key
data/artifacts/
data/snapshots/
data/workspaces/
# 用户贴进来的截图：从仓库根启动后端时会落到这里，属于隐私数据，绝不能进版本库
data/uploads/

# 本机覆盖安装的目标目录（每台机器不同，不入库）
desktop/install-target.local.json

# 本机打包实测与数据备份（临时产物，可能含真实数据库，绝不入库）
_verify/
_backup/

# 本地验证脚本与截图（不是交付物）

# 构建前移走的旧产物（备份目录，不是交付物）
web/.next.dev-*/
web/.next.prev-*/
web/out.prev-*/
web/.next-old*/
web/out-old*/
